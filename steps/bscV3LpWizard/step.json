{
  "id": "bscV3LpWizard",
  "label": "BSC V3 LP wizard",
  "category": "data",
  "description": "Configure PancakeSwap V3 concentrated-liquidity row variables for downstream steps: resolve pool (factory lookup if needed), compute tick range from ±% or explicit min/max prices, optionally preview token amounts from a BNB budget, and save policies (exit below/above). Uses CFS_BSC_QUERY only (no signing). Pair with bscV3AutoApprove and bscPancake v3PositionMint.",
  "defaultAction": {
    "type": "bscV3LpWizard",
    "runIf": "",
    "tokenA": "",
    "tokenB": "",
    "v3Fee": "500",
    "v3Pool": "0x46Cf1cF8c69595804ba91dFdd8d6b960c9B0a7C4",
    "rangePercent": "0.5",
    "rangePercentBelow": "",
    "rangePercentAbove": "",
    "minPrice": "",
    "maxPrice": "",
    "fundMode": "bnb",
    "bnbBudgetWei": "max",
    "gasReserveWei": "",
    "stableBudgetWei": "max",
    "stableReserveWei": "0",
    "stableToken": "0x55d398326f99059fF775485246999027B3197955",
    "exitBelowPolicy": "sell_stable",
    "exitAbovePolicy": "restake",
    "slippageBps": "50",
    "previewAmounts": true,
    "saveTokenA": "tokenA",
    "saveTokenB": "tokenB",
    "saveV3Fee": "v3Fee",
    "saveV3Pool": "v3Pool",
    "saveRangePercent": "rangePercent",
    "saveRangePercentBelow": "rangePercentBelow",
    "saveRangePercentAbove": "rangePercentAbove",
    "saveMinPrice": "minPrice",
    "saveMaxPrice": "maxPrice",
    "saveTickLower": "tickLower",
    "saveTickUpper": "tickUpper",
    "saveBnbBudgetWei": "bnbBudgetWei",
    "saveStableBudgetWei": "stableBudgetWei",
    "saveAmount0Desired": "amount0Desired",
    "saveAmount1Desired": "amount1Desired",
    "saveBnbFor0Wei": "bnbFor0Wei",
    "saveBnbFor1Wei": "bnbFor1Wei",
    "saveToken0": "token0",
    "saveToken1": "token1",
    "saveStableToken": "stableToken",
    "saveExitBelowPolicy": "exitBelowPolicy",
    "saveExitAbovePolicy": "exitAbovePolicy",
    "saveSlippageBps": "slippageBps"
  },
  "formSchema": [
    { "key": "runIf", "label": "Run only if (optional)", "inputType": "text" },
    { "key": "tokenA", "label": "tokenA (0x…)", "inputType": "text" },
    { "key": "tokenB", "label": "tokenB (0x…)", "inputType": "text" },
    { "key": "v3Fee", "label": "v3Fee (uint24 tier)", "inputType": "text", "placeholder": "500" },
    {
      "key": "v3Pool",
      "label": "V3 pool address",
      "inputType": "poolSearch",
      "poolSearchMessage": "CFS_BSC_POOL_SEARCH",
      "poolSearchDeps": ["tokenA", "tokenB"],
      "placeholder": "Leave empty to resolve via factory when tokenA+B+fee set"
    },
    { "key": "rangePercent", "label": "Range ±% around mid (when below/above empty)", "inputType": "text", "placeholder": "0.5" },
    { "key": "rangePercentBelow", "label": "Range % below mid (asymmetric; e.g. 5)", "inputType": "text", "placeholder": "5" },
    { "key": "rangePercentAbove", "label": "Range % above mid (asymmetric; e.g. 15)", "inputType": "text", "placeholder": "15" },
    { "key": "minPrice", "label": "minPrice (optional; token1 per token0)", "inputType": "text" },
    { "key": "maxPrice", "label": "maxPrice (optional; token1 per token0)", "inputType": "text" },
    {
      "key": "fundMode",
      "label": "Amount fund mode",
      "inputType": "select",
      "options": [
        { "value": "bnb", "label": "bnb — size from BNB (v3LpAmountsFromBnb)" },
        { "value": "stable", "label": "stable — size from USDT/stable (v3LpAmountsFromStable)" }
      ]
    },
    { "key": "bnbBudgetWei", "label": "BNB budget wei (max or uint256)", "inputType": "text", "placeholder": "max" },
    { "key": "gasReserveWei", "label": "Gas reserve wei (BNB preview)", "inputType": "text" },
    { "key": "stableBudgetWei", "label": "Stable budget wei (max or uint256)", "inputType": "text", "placeholder": "max" },
    { "key": "stableReserveWei", "label": "Stable dust reserve wei", "inputType": "text", "placeholder": "0" },
    {
      "key": "stableToken",
      "label": "Stablecoin for exit-below policy",
      "inputType": "select",
      "hint": "BSC mainnet addresses. Value saved is the 0x address (or a {{row}} template).",
      "options": [
        {
          "value": "0x55d398326f99059fF775485246999027B3197955",
          "label": "USDT (0x55d398326f99059fF775485246999027B3197955)"
        },
        {
          "value": "0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d",
          "label": "USDC (0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d)"
        },
        {
          "value": "0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56",
          "label": "BUSD (0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56)"
        },
        {
          "value": "0x1AF3F329e8BE154074D8769D1FFa4eE058B1DBc3",
          "label": "DAI (0x1AF3F329e8BE154074D8769D1FFa4eE058B1DBc3)"
        },
        {
          "value": "0xc5f0f7b66764F6ec8C8Dff7BA683102295E16409",
          "label": "FDUSD (0xc5f0f7b66764F6ec8C8Dff7BA683102295E16409)"
        },
        {
          "value": "{{stableToken}}",
          "label": "{{stableToken}} — from row / variable"
        }
      ]
    },
    {
      "key": "exitBelowPolicy",
      "label": "Exit below range",
      "inputType": "select",
      "options": [
        { "value": "sell_stable", "label": "sell_stable — swap to stable" },
        { "value": "restake", "label": "restake — rebalance into new range" }
      ]
    },
    {
      "key": "exitAbovePolicy",
      "label": "Exit above range",
      "inputType": "select",
      "options": [
        { "value": "restake", "label": "restake — rebalance into new range" },
        { "value": "sell_stable", "label": "sell_stable — swap to stable" }
      ]
    },
    { "key": "slippageBps", "label": "Slippage bps (saved for downstream)", "inputType": "text", "placeholder": "50" },
    { "key": "previewAmounts", "label": "Preview amounts from fundMode budget", "inputType": "checkbox" },
    { "key": "saveTokenA", "label": "Save tokenA to variable", "inputType": "text" },
    { "key": "saveTokenB", "label": "Save tokenB to variable", "inputType": "text" },
    { "key": "saveV3Fee", "label": "Save v3Fee to variable", "inputType": "text" },
    { "key": "saveV3Pool", "label": "Save v3Pool to variable", "inputType": "text" },
