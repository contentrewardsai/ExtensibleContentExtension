    { "key": "saveTickUpper", "label": "Save tickUpper to variable", "inputType": "text" },
    { "key": "saveBnbBudgetWei", "label": "Save bnbBudgetWei to variable", "inputType": "text" },
    { "key": "saveAmount0Desired", "label": "Save amount0Desired to variable", "inputType": "text" },
    { "key": "saveAmount1Desired", "label": "Save amount1Desired to variable", "inputType": "text" },
    { "key": "saveStableToken", "label": "Save stableToken to variable", "inputType": "text" },
    { "key": "saveExitBelowPolicy", "label": "Save exitBelowPolicy to variable", "inputType": "text" },
    { "key": "saveExitAbovePolicy", "label": "Save exitAbovePolicy to variable", "inputType": "text" },
    { "key": "saveSlippageBps", "label": "Save slippageBps to variable", "inputType": "text" }
