{
  "id": "bscV3RebalanceOnce",
  "label": "BSC V3 rebalance once",
  "category": "data",
  "description": "Single workflow step that rebalance a PancakeSwap V3 position: remove all liquidity (v3PositionDecreaseLiquidity max), collect owed tokens, optionally burn the NFT, compute the next range via v3RestakeRange, size amounts from BNB (v3LpAmountsFromBnb) with optional BNB→token top-up swaps, ensure ERC-20 approvals, and mint a new position (v3PositionMint). Saves the new v3PositionTokenId and range vars.",
  "defaultAction": {
    "type": "bscV3RebalanceOnce",
    "runIf": "",
    "v3PositionTokenId": "",
    "v3Pool": "",
    "v3Fee": "",
    "rangePercent": "1",
    "driftDirection": "{{driftDirection}}",
    "slippageBps": "50",
    "bnbBudgetWei": "max",
    "gasReserveWei": "",
    "gasLimit": "",
    "burnPosition": true,
    "ensureApprovals": true,
    "swapRouterV3Address": "",
    "positionManagerAddress": "",
    "saveV3PositionTokenIdVariable": "v3PositionTokenId",
    "saveTickLower": "tickLower",
    "saveTickUpper": "tickUpper",
    "saveMinPrice": "minPrice",
    "saveMaxPrice": "maxPrice"
  },
  "formSchema": [
    { "key": "runIf", "label": "Run only if (optional)", "inputType": "text" },
    { "key": "v3PositionTokenId", "label": "V3 position NFT token ID", "inputType": "text", "placeholder": "{{v3PositionTokenId}}" },
    {
      "key": "v3Pool",
      "label": "V3 pool address",
      "inputType": "poolSearch",
      "poolSearchMessage": "CFS_BSC_POOL_SEARCH",
      "poolSearchDeps": [],
      "placeholder": "0x46Cf1cF8c69595804ba91dFdd8d6b960c9B0a7C4"
    },
    { "key": "v3Fee", "label": "v3Fee override (optional; from pool query if empty)", "inputType": "text" },
    { "key": "rangePercent", "label": "Range ±% for restake", "inputType": "text", "placeholder": "1" },
    { "key": "driftDirection", "label": "Drift direction (above|below)", "inputType": "text", "placeholder": "{{driftDirection}}" },
    { "key": "slippageBps", "label": "Slippage bps (mint mins + swap outs)", "inputType": "text", "placeholder": "50" },
    { "key": "bnbBudgetWei", "label": "BNB budget for new amounts (max or wei)", "inputType": "text", "placeholder": "max" },
    { "key": "gasReserveWei", "label": "Gas reserve wei (amount sizing)", "inputType": "text" },
    { "key": "gasLimit", "label": "gasLimit (optional)", "inputType": "text" },
    { "key": "burnPosition", "label": "Burn empty position NFT after collect", "inputType": "checkbox" },
    { "key": "ensureApprovals", "label": "Ensure token0/token1 approvals (router + NPM)", "inputType": "checkbox" },
    { "key": "swapRouterV3Address", "label": "V3 SwapRouter override (optional)", "inputType": "text" },
    { "key": "positionManagerAddress", "label": "V3 NPM override (optional)", "inputType": "text" },
    { "key": "saveV3PositionTokenIdVariable", "label": "Save new position NFT id to variable", "inputType": "text" },
    { "key": "saveTickLower", "label": "Save tickLower to variable", "inputType": "text" },
    { "key": "saveTickUpper", "label": "Save tickUpper to variable", "inputType": "text" },
    { "key": "saveMinPrice", "label": "Save minPrice to variable", "inputType": "text" },
    { "key": "saveMaxPrice", "label": "Save maxPrice to variable", "inputType": "text" }
  ]
}
